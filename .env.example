# ============================================================
# Фещук — Переменные окружения
# ============================================================

# --- ПостgreSQL ---
POSTGRES_DB=feshchuk
POSTGRES_USER=feshchuk
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Absolute base for media URLs returned by the API (covers/previews).
# In Docker the backend only sees internal proxy requests (Host: backend:8000),
# which the browser cannot resolve — set this to your public backend origin.
# For local dev leave http://localhost:8000; in prod use https://your-domain.
API_BASE_URL=http://localhost:8000

# --- RouterAI (OpenAI-совместимый API) ---
ROUTERAI_API_KEY=sk-your_routerai_api_key_here
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# Флагманская языковая модель от Qwen (актуальная версия 3.5)
ROUTERAI_LLM_MODEL=qwen/qwen3.5-plus-20260420
# Топовые мультиязычные эмбеддинги для RAG + pgvector
ROUTERAI_EMBEDDINGS_MODEL=baai/bge-m3
# Генерация голоса (TTS). Имена голосов специфичны для провайдера:
# minimax/speech-* принимают голоса OpenAI (alloy/nova/echo), google/gemini-*-tts — имена Gemini (Kore/Puck/Zephyr/...).
# Неверное имя голоса → 400. Google TTS всегда отдаёт WAV (mp3 игнорируется).
ROUTERAI_TTS_MODEL=google/gemini-3.8-flash-lite-tts
# Голос нейропомощника (глобальный чат). Голоса модулей задаются в admin (AgentModule.tts_voice).
ROUTERAI_TTS_VOICE=Puck
# Формат вывода; для google/*-tts фактический битрейт всегда WAV.
ROUTERAI_TTS_FORMAT=wav
# Высокоточное распознавание речи (STT) для команд агенту
ROUTERAI_STT_MODEL=openai/whisper-large-v3
# Лимит символов, отправляемых в синтез за один запрос
TTS_MAX_CHARS=4000

# --- Context7 (MCP — актуальная документация для модульных AI-агентов) ---
CONTEXT7_API_KEY=your_context7_api_key_here
CONTEXT7_BASE_URL=https://context7.com/api/v1
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
CONTEXT7_TIMEOUT=15

# --- Rate limiting (DRF) ---
# Ставки на реальный IP клиента. В dev весь трафик идёт через rewrite Next.js,
# который не передаёт X-Forwarded-For, поэтому anon-бакет там общий на весь сайт.
THROTTLE_ANON_RATE=2000/hour
THROTTLE_WRITE_RATE=120/hour
THROTTLE_CHAT_RATE=30/hour
THROTTLE_TTS_RATE=30/hour
THROTTLE_STT_RATE=30/hour
# Публичные IP обратных прокси, которым разрешено задавать клиента через
# X-Forwarded-For (приватные/Docker-адреса доверенны всегда).
TRUSTED_PROXY_IPS=

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Nginx ---
NGINX_HOST=localhost
NGINX_PORT=80
HTTPS_ENABLED=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

API_BASE_URL=http://localhost:8000
