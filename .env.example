# ============================================================
# Фестчук — Переменные окружения
# ============================================================

# --- ПостgreSQL ---
POSTGRES_DB=festchuk
POSTGRES_USER=festchuk
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- RouterAI (OpenAI-совместимый API) ---
ROUTERAI_API_KEY=sk-Zyl...i1gz
ROUTERAI_BASE_URL=https://api.routerai.ru/v1
# Флагманская языковая модель от Qwen (актуальная версия 3.5)
ROUTERAI_LLM_MODEL=qwen/qwen3.5-plus-20260420
# Топовые мультиязычные эмбеддинги для RAG + pgvector
ROUTERAI_EMBEDDINGS_MODEL=baai/bge-m3
# Генерация голоса (TTS) с поддержкой потокового аудио
ROUTERAI_TTS_MODEL=heygen/heygen-voice-1-turbo
# Высокоточное распознавание речи (STT) для команд агенту
ROUTERAI_STT_MODEL=openai/whisper-large-v3

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Nginx ---
NGINX_HOST=localhost
NGINX_PORT=80
HTTPS_ENABLED=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
